# ══════════════════════════════════════════════════════════════
#  langchain-workshop 环境变量
#  用法：cp .env.example .env  然后按需填写
#
#  说明：
#  · labs/01–03 完全不需要任何 Key，可以跳过这个文件
#  · labs/04–26 需要「对话模型」；RAG 相关还需要「Embedding」
#  · 两套都走 OpenAI 兼容协议，**换 provider 只改 base_url**
# ══════════════════════════════════════════════════════════════

# ── 对话模型 ─────────────────────────────────────────────
# labs 里 16 处用这一组。默认 DeepSeek，最便宜。
# 想换 OpenAI：AGENT_API_BASE=https://api.openai.com/v1  AGENT_MODEL=gpt-4o-mini
# 想换通义：  AGENT_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
#             AGENT_MODEL=qwen-plus
# 想换本地：  AGENT_API_BASE=http://localhost:11434/v1   （Ollama）
#             AGENT_API_BASE=http://localhost:8000/v1    （vLLM）
AGENT_API_KEY=
AGENT_API_BASE=https://api.deepseek.com/v1
AGENT_MODEL=deepseek-chat

# ── Embedding ───────────────────────────────────────────
# labs 里 8 处用这一组（RAG / 向量库相关）。默认阿里云百炼兼容模式。
# 换 OpenAI：DASHSCOPE_BASE_URL=https://api.openai.com/v1
#           DASHSCOPE_EMBEDDING_MODEL=text-embedding-3-small
# 换本地 Ollama：DASHSCOPE_BASE_URL=http://localhost:11434/v1
#              DASHSCOPE_EMBEDDING_MODEL=nomic-embed-text
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v3

# ── 旧变量（少数早期 lab 兼容用，新代码统一用上面两组）──
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
QWEN_API_KEY=

# ── Langfuse（lab 25 可选，不填就跳过追踪）──────────────
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ── LangSmith（可选，不填就不上报）──────────────────────
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=langchain-workshop
